<body>
<div class="banner" id="banner" role="region" aria-label="Cookie consent">
  <div class="body" id="body">
    <div class="top">
      <div class="plate">
        <svg class="cookie" id="cookie" viewBox="0 0 64 64" aria-hidden="true">
          <defs>
            <radialGradient id="cookie-dough" cx=".34" cy=".26" r=".86"><stop class="d0" offset="0"/><stop class="d1" offset=".5"/><stop class="d2" offset="1"/></radialGradient>
            <radialGradient id="cookie-chip" cx=".36" cy=".3" r=".8"><stop class="c0" offset="0"/><stop class="c1" offset="1"/></radialGradient>
            <radialGradient id="cookie-dent" cx=".5" cy=".62" r=".6"><stop class="n0" offset="0"/><stop class="n1" offset="1"/></radialGradient>
            <mask id="cookie-bites" maskUnits="userSpaceOnUse" x="-8" y="-8" width="80" height="80"><rect class="keep" x="-8" y="-8" width="80" height="80"/><g id="bites"></g></mask>
          </defs>
          <g mask="url(#cookie-bites)">
            <circle class="edge" cx="32" cy="32" r="30"/>
            <circle class="dough" cx="32" cy="31.2" r="29"/>
            <ellipse class="dent" cx="14" cy="27" rx="3.2" ry="2.4"/><ellipse class="dent" cx="34" cy="26" rx="2.6" ry="2"/><ellipse class="dent" cx="50" cy="42" rx="2.8" ry="2.2"/><ellipse class="dent" cx="27" cy="43" rx="2.2" ry="1.7"/>
            <g class="chips">
              <circle cx="22" cy="19" r="4.4"/><circle cx="41" cy="16" r="3.3"/><circle cx="46" cy="31" r="4.2"/>
              <circle cx="30" cy="34" r="3.5"/><circle cx="17" cy="38" r="3.1"/><circle cx="38" cy="48" r="4.4"/><circle cx="24" cy="51" r="2.7"/>
            </g>
          </g>
        </svg>
        <i class="crumbs" id="crumbs"></i>
      </div>
      <div class="copy"><h3>We use cookies</h3><p>They keep you signed in and show us what gets used.</p></div>
    </div>
    <div class="row">
      <button class="btn no" id="no">No thanks</button>
      <button class="btn yes" id="yes">Accept</button>
    </div>
  </div>
  <div class="done" id="done" aria-live="polite"><svg viewBox="0 0 24 24" aria-hidden="true"><path id="tick" pathLength="1" d="M6 12.5l4 4 8-9"/></svg><span id="msg">Cookies accepted</span></div>
</div>
<script>
// Tiny spring engine shared by every component.
// Springs, sim-time timers (so slow-mo slows them too), one rAF loop, and token readers.
window.Motion = (() => {
  // theme: shared by every page through localStorage, live-updated by the gallery
  const setTheme = t => { document.documentElement.dataset.theme = t === 'light' ? 'light' : 'dark'; };
  try { setTheme(localStorage.getItem('ms-theme')); } catch { setTheme('dark'); }
  addEventListener('storage', e => { if (e.key === 'ms-theme') setTheme(e.newValue); });

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const S = (x, k = 400, c = 30) => ({ x, v: 0, t: x, k, c });
  const tune = (s, k, c) => { s.k = k; s.c = reduce ? 2 * Math.sqrt(k) : c; };
  const step = (s, dt) => { const a = -s.k * (s.x - s.t) - s.c * s.v; s.v += a * dt; s.x += s.v * dt; };
  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));

  // tokens from shared/tokens.css
  const token = (name, fallback = '') =>
    getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback;
  const num = (name, fallback) => parseFloat(token(name, String(fallback)));
  const spring = (name, fallback) => token(name, fallback).split(/\s+/).map(Number);

  let timeScale = 1;
  const timers = [];
  const after = (sec, fn) => { const t = { t: sec, fn }; timers.push(t); return t; };
  const cancel = t => { const i = timers.indexOf(t); if (i > -1) timers.splice(i, 1); };

  // slow motion, synced with a parent page when embedded
  const slowListeners = [];
  function setSlow(v, fromParent = false) {
    timeScale = v ? .25 : 1;
    slowListeners.forEach(f => f(v));
    if (!fromParent && parent !== window) parent.postMessage({ type: 'motion:slow-changed', on: v }, '*');
  }
  addEventListener('message', e => {
    if (e.data && e.data.type === 'motion:slow') setSlow(!!e.data.on, true);
    if (e.data && e.data.type === 'motion:theme') setTheme(e.data.theme);
  });

  const comps = [];
  let last = performance.now();
  function loop(now) {
    const dt = Math.min((now - last) / 1000, 1 / 30) * timeScale; last = now;
    for (let i = timers.length - 1; i >= 0; i--) {
      if ((timers[i].t -= dt) <= 0) timers.splice(i, 1)[0].fn();
    }
    const sub = 4;
    for (let k = 0; k < sub; k++) comps.forEach(c => c.frame(dt / sub));
    comps.forEach(c => c.render());
    requestAnimationFrame(loop);
  }
  requestAnimationFrame(loop);

  return {
    S, tune, step, clamp, token, num, spring, after, cancel,
    register: c => comps.push(c),
    get timeScale() { return timeScale; },
    get slow() { return timeScale !== 1; },
    setSlow, onSlow: f => slowListeners.push(f),
    svg: (p, sw = 1.8) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round">${p}</svg>`,
  };
})();

</script>
<script>
// Cookie Bite
// Accept eats the cookie: three bites in a row, each one a cut in the cookie's
// mask that pops open on a spring, with teeth marks, a wobble and crumbs that
// fall with weight; then the last piece is gone. No thanks flicks it: it rolls
// off the edge of the card and drops. After either, the banner's width, height
// and corners spring down to a one-line note with a check that draws itself,
// and a moment later it opens again with a fresh cookie dropped on the plate.
(() => {
  const { S, tune, step, clamp, spring, after } = Motion;
  const $ = id => document.getElementById(id);
  const banner = $('banner'), body = $('body'), cookie = $('cookie'), bitesG = $('bites'), crumbsEl = $('crumbs');
  const yes = $('yes'), no = $('no'), done = $('done'), msg = $('msg'), tick = $('tick');
  const NS = 'http://www.w3.org/2000/svg';

  const T = { pop: spring('--spring-pop', '520 16'), settle: spring('--spring-settle', '280 22'), soft: spring('--spring-soft', '260 24'), fade: spring('--spring-fade', '420 32') };
  // three bites, each a round cut on the rim with three teeth marks on its inner edge
  const BITES = [-42, 28, 196].map(a => {
    const r = a * Math.PI / 180, cx = 32 + Math.cos(r) * 30, cy = 32 + Math.sin(r) * 30;
    const parts = [[cx, cy, 13]];
    [-52, 0, 52].forEach(t => { const q = r + Math.PI + t * Math.PI / 180; parts.push([cx + Math.cos(q) * 11.5, cy + Math.sin(q) * 11.5, 5.2]); });
    const els = parts.map(() => bitesG.appendChild(document.createElementNS(NS, 'circle')));
    const s = S(0, 700, 22); tune(s, 700, 22);
    return { parts, els, s, x: cx, y: cy, a: r };
  });
  const crumbs = Array.from({ length: 18 }, () => ({ el: crumbsEl.appendChild(document.createElement('i')), life: 0, x: 0, y: 0, vx: 0, vy: 0, r: 0, vr: 0 }));
  let ci = 0;

  const M = S(0, ...T.soft);                   // 0 banner, 1 note
  const WW = S(0, ...T.soft), HH = S(0, 230, 22);
  const CS = S(1, ...T.pop);                   // cookie scale
  const CR = S(0, 190, 9);                     // cookie wobble
  const CY = S(0, ...T.settle);                // cookie dropping onto the plate
  const PY = S(1, ...T.pop), PN = S(1, ...T.pop);   // button presses
  const TK = S(0, 160, 20);                    // the check drawing itself
  [[M, T.soft], [WW, T.soft], [HH, [230, 22]], [CS, T.pop], [CR, [190, 9]], [CY, T.settle], [PY, T.pop], [PN, T.pop], [TK, [160, 20]]].forEach(([s, t]) => tune(s, ...t));

  let W0 = 0, H0 = 0, W1 = 0, busy = false, flick = null, clock = 0, userUntil = 0, turn = 0;

  function measure() {
    W0 = Math.min(340, document.body.clientWidth - 32);
    body.style.width = W0 + 'px';
    H0 = body.offsetHeight; W1 = done.offsetWidth;
    WW.t = M.t ? W1 : W0; HH.t = M.t ? 44 : H0;
    if (!WW.x) { WW.x = WW.t; HH.x = HH.t; }
  }
  measure();
  addEventListener('resize', measure);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);

  function spray(x, y, n, power) {             // crumbs, in the cookie's own 64 box
    for (let i = 0; i < n; i++) {
      const c = crumbs[ci++ % crumbs.length], a = Math.random() * Math.PI * 2;
      c.life = .75 + Math.random() * .35; c.x = x - 32; c.y = y - 32;
      c.vx = Math.cos(a) * power * (.4 + Math.random()); c.vy = -Math.abs(Math.sin(a)) * power * (.6 + Math.random()) - 40;
      c.r = 0; c.vr = (Math.random() - .5) * 900;
    }
  }
  function bite(i) {
    const b = BITES[i];
    b.s.t = 1; CR.v += (i % 2 ? -1 : 1) * 520; CS.x = .86;
    spray(b.x, b.y, 5, 150);
  }
  function fold(text, ok) {
    msg.textContent = text; done.classList.toggle('is-yes', ok);
    W1 = done.offsetWidth;
    M.t = 1; WW.t = W1; HH.t = 44; TK.x = 0; TK.t = 0;
    after(.28, () => { TK.t = 1; });
    after(2.1, open);
  }
  function open() {
    BITES.forEach(b => { b.s.x = b.s.t = 0; b.s.v = 0; });
    flick = null; CS.x = .4; CS.t = 1; CS.v = 0; CR.x = CR.v = 0; CY.x = -46; CY.v = 0; CY.t = 0;
    M.t = 0; WW.t = W0; HH.t = H0;
    after(.5, () => { busy = false; });
  }
  function accept() {
    if (busy) return; busy = true; PY.x = .92;
    [0, 1, 2].forEach(i => after(.1 + i * .27, () => bite(i)));
    after(.1 + 3 * .27, () => { tune(CS, 600, 34); CS.t = 0; spray(32, 32, 6, 110); });
    after(1.2, () => { tune(CS, ...T.pop); fold('Cookies accepted', true); });
  }
  function decline() {
    if (busy) return; busy = true; PN.x = .92;
    flick = { x: 0, y: 0, vx: -60, vy: 0 };     // rolls off the left edge of the card, then drops
    after(.8, () => fold('Essentials only', false));
  }
  yes.addEventListener('click', () => { userUntil = clock + 8; accept(); });
  no.addEventListener('click', () => { userUntil = clock + 8; decline(); });

  // idle: accept, then decline, and round again
  (function auto() {
    if (clock >= userUntil && !busy) (turn++ % 2 ? decline : accept)();
    after(1.5, auto);
  })();

  Motion.register({
    frame(dt) {
      clock += dt;
      [M, WW, HH, CS, CR, CY, PY, PN, TK].forEach(s => step(s, dt));
      BITES.forEach(b => step(b.s, dt));
      if (flick) {
        flick.vx -= 620 * dt; flick.x += flick.vx * dt;
        if (flick.x < -46) { flick.vy += 1500 * dt; flick.y += flick.vy * dt; }
      }
      crumbs.forEach(c => {
        if (c.life <= 0) return;
        c.life -= dt; c.vy += 900 * dt; c.x += c.vx * dt; c.y += c.vy * dt; c.r += c.vr * dt;
      });
    },
    render() {
      const m = clamp(M.x, 0, 1);
      banner.style.width = WW.x.toFixed(1) + 'px'; banner.style.height = HH.x.toFixed(1) + 'px';
      banner.style.transform = `translate(${(-WW.x / 2).toFixed(1)}px,${(-HH.x / 2).toFixed(1)}px)`;
      banner.style.borderRadius = Math.min(24, HH.x / 2).toFixed(1) + 'px';
      body.style.opacity = clamp(1 - m * 2.2, 0, 1).toFixed(3);
      body.style.transform = `translate(${((WW.x - W0) / 2).toFixed(1)}px,${((HH.x - H0) / 2).toFixed(1)}px)`;
      body.style.pointerEvents = m > .1 ? 'none' : 'auto';
      banner.style.overflow = M.t || m > .01 ? 'hidden' : 'visible';   // open, the cookie and its crumbs may leave the card; folding, nothing may
      const d = clamp(m * 2.2 - 1.2, 0, 1);
      done.style.opacity = d.toFixed(3);
      done.style.transform = `translate(-50%,-50%) translateY(${((1 - d) * 8).toFixed(2)}px)`;
      tick.style.strokeDashoffset = (1 - clamp(TK.x, 0, 1)).toFixed(4);
      BITES.forEach(b => b.parts.forEach((p, i) => {
        const k = Math.max(0, b.s.x);
        b.els[i].setAttribute('cx', p[0].toFixed(2)); b.els[i].setAttribute('cy', p[1].toFixed(2)); b.els[i].setAttribute('r', (p[2] * k).toFixed(2));
      }));
      const fx = flick ? flick.x : 0, fy = flick ? flick.y : 0;
      cookie.style.transform = `translate(${fx.toFixed(1)}px,${(fy + CY.x).toFixed(1)}px) rotate(${(CR.x * .012 + fx / 28).toFixed(4)}rad) scale(${Math.max(0, CS.x).toFixed(4)})`;
      crumbs.forEach(c => {
        const o = c.life <= 0 ? 0 : Math.min(1, c.life * 3);
        c.el.style.opacity = o.toFixed(2);
        if (o) c.el.style.transform = `translate(${(32 + c.x).toFixed(1)}px,${(32 + c.y).toFixed(1)}px) rotate(${c.r.toFixed(0)}deg)`;
      });
      yes.style.transform = `scale(${PY.x.toFixed(4)})`; no.style.transform = `scale(${PN.x.toFixed(4)})`;
    },
  });
})();

</script>
</body>
